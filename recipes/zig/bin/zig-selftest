#!{{PREFIX}}/bin/sh
# Zig 离线端到端自检：在 $TMPDIR 内实编并运行最小 Zig 程序与 zig cc C 程序，测完清理。
set -eu
WORK=$(mktemp -d "${TMPDIR:-{{PREFIX}}/tmp}/zig-selftest.XXXXXX")
trap 'rm -rf "$WORK"' EXIT
export ZIG_GLOBAL_CACHE_DIR="$WORK/gcache"
export ZIG_LOCAL_CACHE_DIR="$WORK/lcache"

VER=$(zig version)
cd "$WORK"

# CI 的 termux-docker 容器里没有 /system/bin/getprop：zig 默认按安卓宿主推断 API 级别会直接失败
# （unable to resolve target: ApiLevelQueryFailed）。这时改打静态 musl，同样能验证编译与运行；
# 真机上有 getprop，照常走原生 bionic 路径，验的是真实用法。
if command -v getprop >/dev/null 2>&1; then TGT=""; else TGT="-target aarch64-linux-musl"; fi

cat > main.zig <<'EOF'
pub fn main() void {
    const x: i32 = 40 + 2;
    if (x != 42) unreachable;
}
EOF
zig build-exe main.zig -femit-bin="$WORK/zig-hello" $TGT
"$WORK/zig-hello"

cat > ccheck.c <<'EOF'
#include <stdio.h>
int main(void) { printf("zig-cc=OK\n"); return 0; }
EOF
zig cc ccheck.c -o "$WORK/cc-hello" $TGT
CCOUT=$("$WORK/cc-hello")

echo "===== 总结 ===== zig=$VER build-exe=OK $CCOUT"
