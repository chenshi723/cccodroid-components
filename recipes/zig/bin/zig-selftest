#!{{PREFIX}}/bin/sh
# Zig 离线端到端自检：在 $TMPDIR 内实编并运行最小 Zig 程序与 zig cc C 程序，测完清理。
set -eu
WORK=$(mktemp -d "${TMPDIR:-{{PREFIX}}/tmp}/zig-selftest.XXXXXX")
trap 'rm -rf "$WORK"' EXIT
export ZIG_GLOBAL_CACHE_DIR="$WORK/gcache"
export ZIG_LOCAL_CACHE_DIR="$WORK/lcache"

VER=$(zig version)
cd "$WORK"

# CI 的 termux-docker 容器里可能存在 getprop stub，但没有安卓属性服务（ro.build.version.sdk 为空）：
# zig 默认按安卓宿主推断 API 级别会直接失败（unable to resolve target: ApiLevelQueryFailed）。
# 检测不到 SDK 版本时改打静态 musl，同样能验证编译与运行；真机上有 SDK 属性，照常走原生 bionic 路径。
case "$(uname -m)" in
  aarch64|arm64) ZIG_ARCH=aarch64 ;;
  armv7*|arm*)   ZIG_ARCH=arm ;;
  x86_64)        ZIG_ARCH=x86_64 ;;
  *)             ZIG_ARCH=aarch64 ;;
esac
SDK=$(getprop ro.build.version.sdk 2>/dev/null || true)
if [ -n "$SDK" ]; then TGT=""; else TGT="-target ${ZIG_ARCH}-linux-musl"; fi

cat > main.zig <<'EOF'
pub fn main() void {
    const x: i32 = 40 + 2;
    if (x != 42) unreachable;
}
EOF
zig build-exe main.zig -femit-bin="$WORK/zig-hello" $TGT
"$WORK/zig-hello"

cat > ccheck.c <<'EOF'
#include <stdio.h>
int main(void) { printf("zig-cc=OK\n"); return 0; }
EOF
# 纯底座未装 ndk-sysroot 时原生 bionic 缺少 C 头文件；优先用自带 musl（无 SDK 时也绕过 ApiLevelQueryFailed）
CC_TGT="$TGT"
if [ -z "$CC_TGT" ] && [ ! -f "{{PREFIX}}/include/stdio.h" ]; then
  CC_TGT="-target ${ZIG_ARCH}-linux-musl"
fi
zig cc ccheck.c -o "$WORK/cc-hello" $CC_TGT
CCOUT=$("$WORK/cc-hello")

echo "===== 总结 ===== zig=$VER build-exe=OK $CCOUT"
